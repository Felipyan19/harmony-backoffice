# Standard PostgreSQL connection string. Neon is only the current host.
DATABASE_URL=

# Auth.js secret used to encrypt/sign session cookies and JWTs.
# Generate with: npx auth secret
AUTH_SECRET=

# Public base URL of this deployment. Used to build absolute URLs for the
# Open Graph / Twitter preview images shown when a link is shared or pasted.
# Falls back to the Vercel production URL, then localhost, if unset.
NEXT_PUBLIC_APP_URL=
