# Auth.js session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Single-admin credentials for the internal Harmony backoffice V1.
AUTH_ADMIN_EMAIL=

# Store only a bcrypt hash, never the raw password.
# Example generator: node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-password'
AUTH_ADMIN_PASSWORD_HASH=
